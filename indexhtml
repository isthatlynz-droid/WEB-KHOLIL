    <script>
        // State Management
        let currentStep = 1;
        let studentsData = JSON.parse(localStorage.getItem('ppdb_students')) || [
            {
                regNo: 'PPDB2026-001',
                fullname: 'Andi Pratama',
                school_origin: 'SMP Negeri 1 Jakarta',
                major_1: 'Informatika & AI Terapan',
                grade_avg: '89.5',
                registration_path: 'Jalur Prestasi Akademik',
                date: '2026-02-10'
            },
            {
                regNo: 'PPDB2026-002',
                fullname: 'Siti Rahmawati',
                school_origin: 'MTs Negeri 3 Bandung',
                major_1: 'MIPA (Sains & Teknologi)',
                grade_avg: '91.2',
                registration_path: 'Jalur Reguler (Tes)',
                date: '2026-02-12'
            }
        ];

        // Tab Switcher
        function switchTab(tabId) {
            document.querySelectorAll('.tab-page').forEach(page => page.classList.add('hidden'));
            document.getElementById(`page-${tabId}`).classList.remove('hidden');

            // Update Desktop Nav styles
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-primary-600', 'bg-primary-50');
                btn.classList.add('text-slate-600');
            });
            const activeNav = document.getElementById(`nav-${tabId}`);
            if(activeNav) {
                activeNav.classList.add('text-primary-600', 'bg-primary-50');
            }

            // Close mobile menu if open
            document.getElementById('mobile-menu').classList.add('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });

            if(tabId === 'data') {
                renderTable();
            }
        }

        // Mobile Menu Toggle
        document.getElementById('mobile-menu-btn').addEventListener('click', () => {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        });

        // Form Step Controller
        function nextStep(stepIncrement) {
            if(stepIncrement === 1 && !validateCurrentStep()) {
                return;
            }

            currentStep += stepIncrement;
            updateFormStepUI();
        }

        function validateCurrentStep() {
            const currentStepEl = document.getElementById(`form-step-${currentStep}`);
            const inputs = currentStepEl.querySelectorAll('input[required], select[required], textarea[required]');
            let isValid = true;

            inputs.forEach(input => {
                if(!input.value.trim()) {
                    isValid = false;
                    input.classList.add('border-rose-500');
                } else {
                    input.classList.remove('border-rose-500');
                }
            });

            if(!isValid) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Form Belum Lengkap',
                    text: 'Mohon isi semua kolom bertanda * sebelum melanjutkan.',
                    confirmColor: '#4f46e5'
                });
            }

            return isValid;
        }

        function updateFormStepUI() {
            // Hide all steps
            document.querySelectorAll('.form-step').forEach(step => step.classList.add('hidden'));
            document.getElementById(`form-step-${currentStep}`).classList.remove('hidden');

            // Buttons
            const prevBtn = document.getElementById('prev-btn');
            const nextBtn = document.getElementById('next-btn');
            const submitBtn = document.getElementById('submit-btn');

            if(currentStep === 1) {
                prevBtn.classList.add('hidden');
            } else {
                prevBtn.classList.remove('hidden');
            }

            if(currentStep === 4) {
                nextBtn.classList.add('hidden');
                submitBtn.classList.remove('hidden');
                populateReviewSummary();
            } else {
                nextBtn.classList.remove('hidden');
                submitBtn.classList.add('hidden');
            }

            // Update Indicator
            for(let i=1; i<=4; i++) {
                const ind = document.getElementById(`step-ind-${i}`);
                const num = ind.querySelector('.step-num');
                if(i < currentStep) {
                    num.className = 'w-10 h-10 rounded-2xl bg-emerald-500 text-white flex items-center justify-center font-bold mb-2 step-num';
                    num.innerHTML = '<i class="fa-solid fa-check text-xs"></i>';
                } else if(i === currentStep) {
                    num.className = 'w-10 h-10 rounded-2xl bg-primary-600 text-white flex items-center justify-center font-bold mb-2 shadow-md shadow-primary-500/30 step-num';
                    num.innerText = i;
                } else {
                    num.className = 'w-10 h-10 rounded-2xl bg-slate-100 text-slate-500 flex items-center justify-center font-bold mb-2 step-num';
                    num.innerText = i;
                }
            }
        }

        function populateReviewSummary() {
            const summaryBox = document.getElementById('review-summary');
            summaryBox.innerHTML = `
                <div><span class="text-slate-400">Nama:</span> <br><strong class="text-slate-800">${document.getElementById('fullname').value}</strong></div>
                <div><span class="text-slate-400">NIK:</span> <br><strong class="text-slate-800">${document.getElementById('nik').value}</strong></div>
                <div><span class="text-slate-400">Asal Sekolah:</span> <br><strong class="text-slate-800">${document.getElementById('school_origin').value}</strong></div>
                <div><span class="text-slate-400">Pilihan Jurusan 1:</span> <br><strong class="text-primary-600">${document.getElementById('major_1').value}</strong></div>
                <div><span class="text-slate-400">Rata-rata Nilai:</span> <br><strong class="text-slate-800">${document.getElementById('grade_avg').value}</strong></div>
                <div><span class="text-slate-400">Jalur:</span> <br><strong class="text-slate-800">${document.getElementById('registration_path').value}</strong></div>
            `;
        }

        // Submit Form Event
        function submitForm() {
            if(!validateCurrentStep()) return;

            const regNo = 'PPDB2026-' + Math.floor(1000 + Math.random() * 9000);
            const today = new Date().toISOString().split('T')[0];

            const newStudent = {
                regNo: regNo,
                fullname: document.getElementById('fullname').value,
                school_origin: document.getElementById('school_origin').value,
                major_1: document.getElementById('major_1').value,
                grade_avg: document.getElementById('grade_avg').value,
                registration_path: document.getElementById('registration_path').value,
                date: today
            };

            studentsData.unshift(newStudent);
            localStorage.setItem('ppdb_students', JSON.stringify(studentsData));

            // Show Success Alert & Card Modal
            Swal.fire({
                icon: 'success',
                title: 'Pendaftaran Berhasil!',
                text: 'Nomor Pendaftaran Anda adalah: ' + regNo,
                confirmColor: '#4f46e5'
            }).then(() => {
                showModalCard(newStudent);
                document.getElementById('ppdb-form').reset();
                currentStep = 1;
                updateFormStepUI();
            });
        }

        function showModalCard(student) {
            document.getElementById('card-regno').innerText = student.regNo;
            document.getElementById('card-date').innerText = student.date;
            document.getElementById('card-name').innerText = student.fullname;
            document.getElementById('card-school').innerText = student.school_origin;
            document.getElementById('card-major1').innerText = student.major_1;
            document.getElementById('card-path').innerText = student.registration_path;

            document.getElementById('modal-card').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modal-card').classList.add('hidden');
        }

        // Render Data Table
        function renderTable() {
            const tbody = document.getElementById('student-table-body');
            const searchKeyword = document.getElementById('search-input').value.toLowerCase();
            tbody.innerHTML = '';

            const filteredData = studentsData.filter(item => 
                item.fullname.toLowerCase().includes(searchKeyword) ||
                item.regNo.toLowerCase().includes(searchKeyword)
            );

            document.getElementById('total-count').innerText = `Total: ${filteredData.length} Pendaftar`;

            if(filteredData.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center py-8 text-slate-400">Belum ada data pendaftar simulasi.</td>
                    </tr>
                `;
                return;
            }

            filteredData.forEach(student => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 transition';
                tr.innerHTML = `
                    <td class="p-4 font-mono font-bold text-primary-600">${student.regNo}</td>
                    <td class="p-4 font-bold text-slate-900">${student.fullname}</td>
                    <td class="p-4">${student.school_origin}</td>
                    <td class="p-4"><span class="bg-primary-50 text-primary-700 px-2.5 py-1 rounded-full font-semibold">${student.major_1}</span></td>
                    <td class="p-4 font-bold">${student.grade_avg}</td>
                    <td class="p-4"><span class="bg-emerald-50 text-emerald-600 px-2.5 py-1 rounded-full font-semibold border border-emerald-200">Terdaftar</span></td>
                    <td class="p-4 text-center">
                        <button onclick="viewStudentCard('${student.regNo}')" class="text-primary-600 hover:text-primary-800 font-bold px-2 py-1 bg-primary-50 hover:bg-primary-100 rounded-lg transition">
                            <i class="fa-solid fa-id-card mr-1"></i> Kartu
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function viewStudentCard(regNo) {
            const student = studentsData.find(s => s.regNo === regNo);
            if(student) {
                showModalCard(student);
            }
        }

        function clearData() {
            Swal.fire({
                title: 'Bersihkan Data Simulasi?',
                text: 'Tindakan ini akan menghapus seluruh data simulasi yang tersimpan di browser Anda.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Hapus!',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    studentsData = [];
                    localStorage.removeItem('ppdb_students');
                    renderTable();
                    Swal.fire('Terhapus!', 'Data simulasi telah dibersihkan.', 'success');
                }
            });
        }

        // Initialize App
        window.onload = function() {
            renderTable();
        };
    </script>
